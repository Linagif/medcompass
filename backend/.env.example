# Copy this file to ".env" (same folder) and fill in values.
# NEVER commit the real .env file.

# Leave AI_API_KEY empty to run in clearly-labelled DEMO mode (no AI calls are made).
AI_API_KEY=

# Any OpenAI-compatible chat-completions API. The app calls {AI_BASE_URL}/chat/completions
# Example: https://api.openai.com/v1
AI_BASE_URL=

# Model name offered by your provider
AI_MODEL=

# The only browser origin allowed to call this API (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: seconds to wait for the AI provider (default 45)
AI_TIMEOUT_SECONDS=45
